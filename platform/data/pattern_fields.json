{
  "_about": "Which fields of each publicly accessible / vulnerable services report make patterns for researchers (svc_patterns.py), shipped with Looking Glass and replaced by updates. Chosen from the analysis of real reports (10 November 2026): identity fields (fingerprints, banners, versions, models) cluster hosts in a way that means something. Researchers choose their own per report on the Definitions page (data/pattern_fields_local.json, kept on updates). kind: exact = the value as it is (fingerprints, versions, codes); template = free text with what names a host masked (hostmask.py); product = product and version read from the text by the product rules; tags = the tag field read as a set (its CVEs go to Issues). A value is shown only when at least 5 hosts share it.",
  "all_reports": [{"field": "tag", "kind": "tags", "label": "Tags"}],
  "never": ["ip", "hostname", "hostname_source", "asn", "geo", "region", "city", "naics", "sic", "sector", "timestamp",
            "extracted_date", "logged_date", "filename", "line_hash", "sysname", "mac_address", "www_authenticate",
            "subject_email_address", "issuer_email_address", "cert_serial_number", "serial_number", "machine_name",
            "src_ip", "dst_ip", "src_hostname", "dst_hostname", "email", "username", "entity_name", "website"],
  "noise": ["port", "protocol", "severity", "amplification", "response_size", "size", "device_sector", "http_code", "http_reason",
            "content_type", "connection", "handshake", "cipher_suite", "key_algorithm", "signature_algorithm", "validation_level"],
  "never_patterns": ["_date$", "^cert_valid_(from|to)$", "time", "_spi$", "message_id", "^ecdsa_public_key", "^rsa_modulus$",
                     "uptime", "_ip$"],
  "reports": {
    "scan_ssh": [
      {"field": "hassh", "kind": "exact", "label": "SSH fingerprint (HASSH)"},
      {"field": "serverid_raw", "kind": "product", "label": "SSH software"},
      {"field": "server_host_key_sha256", "kind": "exact", "label": "Host key (SHA-256)"}],
    "scan_ssl": [
      {"field": "jarm", "kind": "exact", "label": "TLS fingerprint (JARM)"},
      {"field": "issuer_common_name", "kind": "template", "label": "Certificate issuer"},
      {"field": "subject_organization_name", "kind": "template", "label": "Certificate organisation"},
      {"field": "sha256_fingerprint", "kind": "exact", "label": "Certificate (SHA-256)"},
      {"field": "self_signed", "kind": "exact", "label": "Self-signed"},
      {"field": "server_type", "kind": "product", "label": "Server software"}],
    "scan_ssl_poodle": [
      {"field": "jarm", "kind": "exact", "label": "TLS fingerprint (JARM)"},
      {"field": "issuer_common_name", "kind": "template", "label": "Certificate issuer"},
      {"field": "sha256_fingerprint", "kind": "exact", "label": "Certificate (SHA-256)"},
      {"field": "device_vendor", "kind": "exact", "label": "Device vendor"}],
    "scan_ssl_freak": [
      {"field": "issuer_common_name", "kind": "template", "label": "Certificate issuer"},
      {"field": "sha256_fingerprint", "kind": "exact", "label": "Certificate (SHA-256)"}],
    "scan_http": [{"field": "server", "kind": "product", "label": "Server software"}],
    "scan_http_vulnerable": [{"field": "server", "kind": "product", "label": "Server software"}],
    "scan_ftp": [{"field": "banner", "kind": "template", "label": "Banner"}, {"field": "banner", "kind": "product", "label": "FTP software"}],
    "scan_telnet": [{"field": "banner", "kind": "template", "label": "Banner"}, {"field": "banner", "kind": "product", "label": "Device software"}],
    "scan_smtp": [{"field": "banner", "kind": "template", "label": "Banner"}, {"field": "banner", "kind": "product", "label": "Mail software"}],
    "scan_imap": [{"field": "banner", "kind": "template", "label": "Banner"}, {"field": "banner", "kind": "product", "label": "Mail software"},
                  {"field": "issuer_common_name", "kind": "template", "label": "Certificate issuer"}],
    "scan_pop3": [{"field": "banner", "kind": "template", "label": "Banner"}, {"field": "banner", "kind": "product", "label": "Mail software"},
                  {"field": "issuer_common_name", "kind": "template", "label": "Certificate issuer"}],
    "scan_snmp": [{"field": "sysdesc", "kind": "template", "label": "System description"}, {"field": "sysdesc", "kind": "product", "label": "Device software"},
                  {"field": "device_vendor", "kind": "exact", "label": "Device vendor"}],
    "scan_mikrotik_service": [{"field": "version", "kind": "exact", "label": "RouterOS version"}],
    "device_id": [{"field": "device_vendor", "kind": "exact", "label": "Device vendor"}, {"field": "device_type", "kind": "exact", "label": "Device type"},
                  {"field": "device_model", "kind": "exact", "label": "Device model"}],
    "scan_ntp": [{"field": "version", "kind": "product", "label": "NTP version"}, {"field": "system", "kind": "exact", "label": "System"},
                 {"field": "refid", "kind": "template", "label": "Reference"}],
    "scan_gtp": [{"field": "raw_response", "kind": "exact", "label": "GTP response"}],
    "scan_mysql": [{"field": "server_version", "kind": "exact", "label": "MySQL version"}],
    "scan_postgres": [{"field": "protocol_error_file", "kind": "exact", "label": "Error source"}, {"field": "startup_error_file", "kind": "exact", "label": "Startup error source"}],
    "scan_rdp": [{"field": "rdp_protocol", "kind": "exact", "label": "RDP security"}],
    "scan_netbios": [{"field": "workgroup", "kind": "template", "label": "Workgroup"}],
    "scan_stun": [{"field": "software", "kind": "product", "label": "STUN software"}]
  }
}
