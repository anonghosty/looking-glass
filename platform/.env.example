# Looking Glass configuration. Copy to .env (deploy/install.sh does this), fill in, keep it private (chmod 600).
# Every setting is explained in docs/CONFIGURATION.md. Never commit .env.

# ---- MongoDB: the database filled by the Shadowserver pipeline (../database)
# Use the read-only account made by deploy/create_readonly_db_user.py, not an administrator.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
MONGO_DB=shadowserver
# Collections to use (comma separated). Empty = every compatible report found in the database (recommended).
MONGO_COLLECTIONS=
# Collections never to use (comma separated).
EXCLUDE_COLLECTIONS=outdated_dnssec_key

# ---- Map
# Mapbox access token (free account at https://account.mapbox.com). Restrict it to your site's address there.
MAPBOX_TOKEN=

# ---- Replay
# Events from (now - REPLAY_OFFSET_HOURS) are played now: 24 = yesterday's events at today's clock time.
REPLAY_OFFSET_HOURS=24
# A report counts as complete once it has received no new rows for this many seconds.
REPORT_SETTLE_SECONDS=600
# Most events sent to a browser per poll.
MAX_EVENTS_PER_POLL=400

# ---- Malpedia (optional): the "Look up on Malpedia" button. Free token at https://malpedia.caad.fkie.fraunhofer.de
# Server side only; never sent to browsers.
MALPEDIA_TOKEN=

# ---- CVE look-ups (optional key): NIST NVD allows 5 look-ups per 30 s without a key, 50 with one.
# Free key at https://nvd.nist.gov/developers/request-an-api-key . CISA KEV and EPSS need no key.
NVD_API_KEY=

# ---- Country and constituency (the Settings page overrides these once saved)
# Country the CSIRT covers (ISO 3166-1 alpha-2, any country or territory in the world, XK for Kosovo): region maps
# and labels.
COUNTRY=GH
# AS numbers and address ranges the CSIRT is responsible for (comma separated; empty = the whole country).
CONSTITUENT_ASNS=
CONSTITUENT_CIDRS=

# ---- Security (docs/SECURITY.md, docs/INSTALLATION.md)
# Who may reach Looking Glass (everything still needs a sign-in with MFA):
#   local   this computer only (default)
#   private this computer + the addresses / ranges in VIEWER_NETWORKS (an allow list / ACL)
#   public  any address (internet-facing: put HTTPS in front, see docs/INSTALLATION.md)
# VIEWER_NETWORKS=any (or *) also means public. Other computers must use HTTPS to sign in (deploy/make_tls_cert.sh),
# unless ALLOW_INSECURE_REMOTE_LOGIN=1.
ACCESS_MODE=local
VIEWER_NETWORKS=
# Extra host names people use to reach it (localhost, 127.0.0.1 and this machine's own names and addresses are
# always allowed). * = any host name (a public site under several names).
ALLOWED_HOSTS=
# Two-step login (password + authenticator app code) for every account. 0 only for a closed lab.
MFA_REQUIRED=1
# "Create an account" on the sign-in page (new accounts wait for an administrator's approval). 0 = administrators only.
REGISTRATION=1
# Sessions: end after this many idle minutes, and after this many hours in any case. "Stay signed in" sessions last
# up to 5 days (fixed), with a new session ID every 12 hours.
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
# 1 when a reverse proxy on this computer (Caddy / nginx) does HTTPS in front of Looking Glass (docs/INSTALLATION.md):
# the real client address and https are taken from its X-Forwarded-* headers.
TRUST_PROXY=0
# 1 only for a closed lab: lets other computers log in over plain HTTP (passwords readable on the network).
ALLOW_INSECURE_REMOTE_LOGIN=0
# 1 forces masking (demo mode) for every viewer: public screens.
PUBLIC_DEMO=0
# Diagnostics only: 1 = the browser reports what the Content-Security-Policy would block instead of blocking it.
CSP_REPORT_ONLY=0
# Requests slower than this many seconds are logged by route (data/slow_requests.jsonl; never addresses or query
# text) so slow pages in real use can be found: ./manage/slow_requests.py. 0 = off.
SLOW_REQUEST_S=2
# A few heavy read-only answers (Definitions lists, Intel summary and leads, ATT&CK) are kept this many seconds and
# computed one at a time; any change starts afresh. 0 = off.
CACHE_TTL_S=180
# Sign-in locks (bounds in brackets keep guessing slow). Admins see and can lift locks on /admin → Locked sign-ins.
# Wrong tries for one account from one address before it is locked (3..20), and for how long (minutes, 5..240):
LOGIN_ACCOUNT_FAILS=5
LOGIN_ACCOUNT_LOCK_MIN=15
# Failures from one address within the window (minutes, 15..1440) before the whole address is locked (10..500).
# Raise it when many people sign in from one public address (an office, a partner behind one gateway).
LOGIN_ADDRESS_FAILS=20
LOGIN_ADDRESS_WINDOW_MIN=60
# Heavy views (statistics, map, analysis, drill-down lists, regions, reports) per person: at most this many at once
# (the rest wait their turn, up to HEAVY_WAIT_S seconds), and this many a minute (more: 429). 0 = no limit.
HEAVY_PER_USER=3
HEAVY_PER_MINUTE=240
HEAVY_WAIT_S=20
# Strict-Transport-Security on answers over HTTPS (seconds; 0 tells browsers to forget it). includeSubDomains and
# preload only when every name under the domain is on HTTPS for good.
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=0
HSTS_PRELOAD=0
# The public key backups are encrypted to (an age recipient "age1..." or a GnuPG public key; docs/OPERATIONS.md).
# Empty: data/backup_public_key. The private key stays with you, off this server.
BACKUP_PUBLIC_KEY=
# Admins' bell: warn when the pipeline has not finished a run for this many hours.
PIPELINE_STALE_HOURS=26
# tools/resource_check.py (run by every release): warn and stop above these.
RESOURCE_WEB_MB=4096
RESOURCE_MONGO_MB=4096
RESOURCE_MIN_FREE_GB=5

# ---- Executive portal: 7-day baselines built at the same time, and how many more may wait (management.py)
EXEC_BASELINE_WORKERS=2
EXEC_BASELINE_QUEUE=20

# ---- Audit portal and the audit log (audit_portal.py, audit_chain.py): set them to what your audits and laws require
# Days archived audit entries are kept (compressed, data/audit_archive/) before they are deleted. 400 = a yearly audit + margin.
AUDIT_RETENTION_DAYS=400
# The secret key that seals every copy and download for Trace a leak (insider.py). Leave it empty: Looking Glass makes
# one at the first start in data/copy_seal.key (owner-only). Set it only to share one key between installations.
# COPY_SEAL_KEY=
# A removed archive followed by this many days without any entry is reported for the auditor (a sign that entries were
# deleted and the retention note's dates faked; real use writes more often).
AUDIT_GAP_DAYS=30
# Size in MB at which data/audit.log is archived and a new file started (the tamper-evident chain goes on).
AUDIT_ROTATE_MB=5
# Hours between signed checkpoints of the log's head (data/audit_checkpoints/, audit_checkpoint.py); 0 = never.
AUDIT_CHECKPOINT_HOURS=24
# A folder on another computer, mounted here, that gets a copy of every checkpoint (empty: none; fetch them instead).
AUDIT_CHECKPOINT_COPY_DIR=
# Control checks (evidence only, no pass or fail): an active account unused this many days is listed as "dormant"; the
# administrator limit the check names; registrations waiting longer than this many days are listed; sign-ins outside
# these hours (UTC) are counted. 45 days is CIS's figure (CIS Controls v8.1 safeguard 5.3).
AUDIT_DORMANT_DAYS=45
AUDIT_MAX_ADMINS=3
AUDIT_PENDING_DAYS=7
AUDIT_WORK_HOURS=07-19
# Control check LG-06 (NIST AC-7): the evidence says whether this many failed sign-ins from one address in one day was
# reached.
AUDIT_FAIL_ALERT=10
# Control check LG-13 (NIST AU-6): the review interval the check names (integrity check or evidence export). 7 days is
# CIS's figure (weekly reviews, CIS Controls v8.1 safeguard 8.11).
AUDIT_REVIEW_DAYS=7

# ---- Advanced (the defaults suit almost everyone)
# Secret for the short host references shown instead of IP addresses when masked. Empty = a new random one at each
# start (references then change after a restart). Set a long random value to keep them stable.
REF_SECRET=
# How often a loaded day is checked against MongoDB (seconds; kept, with every answer, while the rows are the same), how
# often it is read in full anyway, and how often the list of reports is fully re-checked.
DAY_RELOAD_SECONDS=600
DAY_MAX_AGE_SECONDS=3600
REGISTRY_REFRESH_SECONDS=3600
# New rows are loaded once their counts stop changing, or at least this often during a long pipeline run (seconds).
SETTLE_MAX_SECONDS=120
# With the pipeline's marks (lg_load_stamps), every report's rows are counted only when a mark moved, or this often.
COUNT_EVERY_SECONDS=600
# 1 = load collections that have no filename index by extracted_date, which has no index: EVERY row is read for each
# day. Leave it off; create the filename index instead (docs/OPERATIONS.md).
FALLBACK_SCAN=0
# Port the service listens on. Set by deploy/install.sh --port (or the installer); the check scripts read it.
LG_PORT=5000
# Port for "python app.py" (development only).
PORT=5000
