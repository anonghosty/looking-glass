# Looking Glass configuration. Copy to .env (deploy/install.sh does this), fill in, keep it private (chmod 600).
# Every setting is explained in docs/CONFIGURATION.md. Never commit .env.

# ---- MongoDB: the database filled by the Shadowserver pipeline (../database)
# Use the read-only account made by deploy/create_readonly_db_user.py, not an administrator.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
MONGO_DB=shadowserver
# Collections to use (comma separated). Empty = every compatible report found in the database (recommended).
MONGO_COLLECTIONS=
# Collections never to use (comma separated).
EXCLUDE_COLLECTIONS=outdated_dnssec_key

# ---- Map
# Mapbox access token (free account at https://account.mapbox.com). Restrict it to your site's address there.
MAPBOX_TOKEN=

# ---- Replay
# Events from (now - REPLAY_OFFSET_HOURS) are played now: 24 = yesterday's events at today's clock time.
REPLAY_OFFSET_HOURS=24
# A report counts as complete once it has received no new rows for this many seconds.
REPORT_SETTLE_SECONDS=600
# Most events sent to a browser per poll.
MAX_EVENTS_PER_POLL=400

# ---- Malpedia (optional): the "Look up on Malpedia" button. Free token at https://malpedia.caad.fkie.fraunhofer.de
# Server side only; never sent to browsers.
MALPEDIA_TOKEN=

# ---- CVE look-ups (optional key): NIST NVD allows 5 look-ups per 30 s without a key, 50 with one.
# Free key at https://nvd.nist.gov/developers/request-an-api-key . CISA KEV and EPSS need no key.
NVD_API_KEY=

# ---- Country and constituency (the Settings page overrides these once saved)
# Country the CSIRT covers (ISO 3166 alpha-2, any of the 54 African countries): region maps and labels.
COUNTRY=GH
# AS numbers and address ranges the CSIRT is responsible for (comma separated; empty = the whole country).
CONSTITUENT_ASNS=
CONSTITUENT_CIDRS=

# ---- Security (docs/SECURITY.md, docs/INSTALLATION.md)
# Who may reach Looking Glass (everything still needs a sign-in with MFA):
#   local   this computer only (default)
#   private this computer + the addresses / ranges in VIEWER_NETWORKS (an allow list / ACL)
#   public  any address (internet-facing: put HTTPS in front, see docs/INSTALLATION.md)
# VIEWER_NETWORKS=any (or *) also means public. Other computers must use HTTPS to sign in (deploy/make_tls_cert.sh),
# unless ALLOW_INSECURE_REMOTE_LOGIN=1.
ACCESS_MODE=local
VIEWER_NETWORKS=
# Extra host names people use to reach it (localhost, 127.0.0.1 and this machine's own names and addresses are
# always allowed). * = any host name (a public site under several names).
ALLOWED_HOSTS=
# Two-step login (password + authenticator app code) for every account. 0 only for a closed lab.
MFA_REQUIRED=1
# "Create an account" on the sign-in page (new accounts wait for an administrator's approval). 0 = administrators only.
REGISTRATION=1
# Sessions: end after this many idle minutes, and after this many hours in any case. "Stay signed in" sessions last
# up to 5 days (fixed), with a new session ID every 12 hours.
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
# 1 when a reverse proxy on this computer (Caddy / nginx) does HTTPS in front of Looking Glass (docs/INSTALLATION.md):
# the real client address and https are taken from its X-Forwarded-* headers.
TRUST_PROXY=0
# 1 only for a closed lab: lets other computers log in over plain HTTP (passwords readable on the network).
ALLOW_INSECURE_REMOTE_LOGIN=0
# 1 forces masking (demo mode) for every viewer: public screens.
PUBLIC_DEMO=0
# Diagnostics only: 1 = the browser reports what the Content-Security-Policy would block instead of blocking it.
CSP_REPORT_ONLY=0

# ---- Advanced (the defaults suit almost everyone)
# Secret for the short host references shown instead of IP addresses when masked. Empty = a new random one at each
# start (references then change after a restart). Set a long random value to keep them stable.
REF_SECRET=
# How often the replay day is reloaded from MongoDB (seconds), and how often the list of reports is fully re-checked.
DAY_RELOAD_SECONDS=600
REGISTRY_REFRESH_SECONDS=3600
# 1 = load collections that have no filename index with a slower scan (better: create the index; docs/OPERATIONS.md).
FALLBACK_SCAN=0
# Port the service listens on. Set by deploy/install.sh --port (or the installer); the check scripts read it.
LG_PORT=5000
# Port for "python app.py" (development only).
PORT=5000
