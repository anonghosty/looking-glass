# secrets and local configuration
.env
.env.*
!.env.example
# Python: .venv is a link to the environment in use in .venvs/ (deploy/safe_libraries.py)
.venv/
.venv
.venvs/
# refused library files, if any (deploy/safe_libraries.py): this computer's report
suspected-packages.*
__pycache__/
*.pyc
# runtime data: accounts, sessions, audit log, settings, caches, certificates, keys.
# Only the curated reference files below belong in the repository.
data/*
!data/infections.json
!data/service_reports.json
!data/issues.json
!data/report_map_rules.json
!data/report_map_snapshot.json
!data/pattern_fields.json
!data/product_rules.json
!data/report_impact.json
!data/attack_rules.json
# rendered by deploy/install.sh for this computer
deploy/*.service
# outputs of the tools/ diagnostics
tools/discovery.json
tools/services_fields.json
# old location of the geocoding cache
/geocache.json
*.log
# code files a later release no longer ships, moved aside on update (deploy/stale_files.py)
backups/
