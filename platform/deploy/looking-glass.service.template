[Unit]
Description=Looking Glass (replay of the previous day's Shadowserver events and exposed services)
After=network-online.target mongod.service
Wants=network-online.target

# Template: deploy/install.sh fills in @USER@, @PROJECT@ and @BIND@ and writes deploy/looking-glass.service.
[Service]
User=@USER@
WorkingDirectory=@PROJECT@
# One worker keeps a single in-memory day cache; threads handle concurrent viewers.
# @BIND@ is 127.0.0.1:5000 (this computer only) or 0.0.0.0:5000 (other screens: set ACCESS_MODE in .env and use HTTPS,
# deploy/make_tls_cert.sh or a reverse proxy; docs/INSTALLATION.md).
ExecStart=@PROJECT@/.venv/bin/gunicorn --workers 1 --threads 8 --bind @BIND@ --access-logfile - app:app
Restart=always
RestartSec=5
# files it creates (sessions, caches, certificates) are private to its user
UMask=0077
# sandbox: no privilege gain, private /tmp, read-only system, writable only where it keeps data
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@PROJECT@/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
SystemCallArchitectures=native
# sockets: only those the platform uses (its own HTTP, MongoDB, DNS and the HTTPS look-ups; netlink for the C library's
# name lookups); raw and packet sockets are refused (review 2026-11-13)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# no capabilities at all, no real-time scheduling, no clock, kernel log or host name changes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictRealtime=true
ProtectClock=true
ProtectKernelLogs=true
ProtectHostname=true
# the system calls of an ordinary service only (systemd's @system-service set); anything else answers "not permitted"
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
