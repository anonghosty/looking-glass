# Shadowserver pipeline configuration. Copy to .env and fill in.
# Values are read literally (no shell expansion), so $, # and @ in passwords are fine.
# Quotes around a value are optional.

# --- Mailbox that receives the Shadowserver reports (docs/MAIL_SETUP.md: how to create the credentials) ---
# imap = any mail server, also Gmail / Google Workspace with an app password
# gmail_api = Google Workspace, service account with domain-wide delegation (no password stored)
# microsoft_graph = Microsoft 365 / Exchange Online, app registration with Mail.Read
MAIL_PROVIDER=imap
# Pull e-mails received in the last N days on each run (1 = since yesterday). Messages and links already handled
# are skipped, so frequent runs (shadowserver schedule every 30m) stay fast, and a few days back lets a run catch up
# after the computer was off or the mailbox unreachable. The installer asks for this (7 recommended).
EMAIL_DAYS=7

# imap
IMAP_SERVER=mail.example.org
IMAP_USER=user@example.org
IMAP_PASSWORD=change-me
IMAP_FOLDER=inbox
# Check the mail server's certificate (false only for a self-signed certificate).
IMAP_VERIFY_TLS=true

# gmail_api
GMAIL_SERVICE_ACCOUNT_FILE=secrets/gmail-service-account.json
GMAIL_USER=
GMAIL_LABEL=INBOX

# microsoft_graph
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=
MS_FOLDER=inbox

# --- MongoDB (created by deploy.sh as the root user in the admin database) ---
# true = MongoDB runs on this computer (deploy.sh installs and configures it). false = it runs on another server
# (MONGO_HOST): nothing is installed here, the account below must already exist there.
MONGO_LOCAL=true
# Addresses the local MongoDB listens on: 127.0.0.1 (this computer only), or also this server's address
# (127.0.0.1,10.0.0.5) when the Looking Glass platform runs on another computer. Firewall it to that computer.
MONGO_BIND=127.0.0.1
# true lets deploy.sh reconfigure a MongoDB that was installed before Looking Glass (port, addresses, access control,
# restart). Default false: deploy.sh refuses, and such a MongoDB is used as it is with MONGO_LOCAL=false.
MONGO_TAKE_OVER=false
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=shadowserver_admin
MONGO_PASSWORD=change-me
MONGO_AUTH_SOURCE=admin
MONGO_DB=shadowserver

# --- Native MongoDB install (systemd service 'mongod'), sized for an ~11 GB WSL VM ---
# MongoDB release series installed from repo.mongodb.org
MONGO_SERIES=8.0
# WiredTiger cache (/etc/mongod.conf) and hard memory cap for the service (systemd MemoryMax)
MONGO_CACHE_GB=1.5
MONGO_MEMORY_LIMIT=3g

# --- Pipeline ---
# Folder holding attachments_backup/, unzipped_backup/, sorting_backup/ (default: this folder)
DATA_DIR=
# Parallel loader processes (each ~100-200 MB). 6 is a good fit for 11 GB RAM.
WORKERS=6
INSERT_CHUNK=2000
DOWNLOAD_THREADS=4
IMAP_FETCH_BATCH=25
# Report file names: YYYY-MM-DD-<service>[-NNN]-<REPORT_SUFFIX>[_asNNNN].csv. Empty = any "<country>-geo"
# (ghana-geo, kenya-geo, south-africa-geo...). A regular expression, for reports named differently.
REPORT_SUFFIX=
