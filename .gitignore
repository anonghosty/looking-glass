# Each folder has its own .gitignore; these apply to the whole repository as a safety net.
.env
.env.*
!.env.example
.venv/
# the Python environments (deploy/safe_libraries.py): .venv is a link to the one in use in .venvs/
.venv
.venvs/
# the library files kept by the installer (~/looking-glass/libraries when this folder is ~/looking-glass) and the
# report of refused library files: this computer's, never the repository's
/libraries/
suspected-packages.*
__pycache__/
*.pyc
*.log
# run logs and scratch notes of any kind (only the dependency lists are text files in this repository)
logs/
*.txt
!requirements.txt
# the list of the maintainer's checks: the suite needs it (tests/run_all_checks.sh, tests/check_suite_split.py)
!platform/tests/maintainer_rows.txt
*.output
*.tmp
# created by install.sh: its log (no secrets, but local details) and the checker's Python environment
install-logs/
.installer-venv/
.installer-venv
# marker left by platform/tools/make_release.py
.looking-glass-release
